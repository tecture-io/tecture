{
  "name": "@tecture/skill",
  "version": "0.3.0",
  "description": "Install and update the Tecture architecture-docs agent skill across Claude Code, Cursor, GitHub Copilot, Codex, and Windsurf — one command, no registry.",
  "keywords": [
    "agent-skills",
    "skill",
    "claude-code",
    "cursor",
    "github-copilot",
    "codex",
    "windsurf",
    "architecture",
    "installer"
  ],
  "license": "MIT",
  "author": "Shanika Wijerathna <shanikacj@gmail.com>",
  "homepage": "https://github.com/tecture-io/tecture#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tecture-io/tecture.git",
    "directory": "packages/installer"
  },
  "bugs": {
    "url": "https://github.com/tecture-io/tecture/issues"
  },
  "type": "module",
  "bin": "./dist/cli.js",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup && node scripts/copy-skill.mjs",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
