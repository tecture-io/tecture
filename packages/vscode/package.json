          "patternErrorMessage": "Use hex (#rgb, #rrggbb, #rrggbbaa), rgb()/rgba(), hsl()/hsla() or a CSS colour name.",
          "maxLength": 64,
          "default": "#22d3ee",
          "markdownDescription": "Minimap node colour. Hex, `rgb()`/`rgba()`, `hsl()`/`hsla()` or a CSS colour name.",
          "scope": "window"
        },
        "tecture.graph.minimap.maskColor": {
          "type": "string",
          "format": "color",
          "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:[rR][gG][bB]|[hH][sS][lL])[aA]?\\([ \\t\\n\\r\\f\\d.,%/+a-zA-Z-]*\\)|[a-zA-Z]{3,24})\\s*$",
          "patternErrorMessage": "Use hex (#rgb, #rrggbb, #rrggbbaa), rgb()/rgba(), hsl()/hsla() or a CSS colour name.",
          "maxLength": 64,
          "default": "rgba(10, 15, 26, 0.7)",
          "markdownDescription": "Minimap viewport mask colour. Hex, `rgb()`/`rgba()`, `hsl()`/`hsla()` or a CSS colour name.",
          "scope": "window"
        },
        "tecture.graph.controls.visible": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show zoom controls.",
          "scope": "window"
        },
        "tecture.graph.legend.visible": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the legend.",
          "scope": "window"
        },
