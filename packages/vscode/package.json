          "type": "number",
          "default": 20,
          "minimum": 4,
          "maximum": 200,
          "markdownDescription": "Canvas grid spacing (px).",
          "scope": "window"
        },
        "tecture.graph.canvas.gridColor": {
          "type": "string",
          "format": "color",
          "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:[rR][gG][bB]|[hH][sS][lL])[aA]?\\([ \\t\\n\\r\\f\\d.,%/+a-zA-Z-]*\\)|[a-zA-Z]{3,24})\\s*$",
          "patternErrorMessage": "Use hex (#rgb, #rrggbb, #rrggbbaa), rgb()/rgba(), hsl()/hsla() or a CSS colour name.",
          "maxLength": 64,
          "default": "rgba(34, 78, 130, 0.12)",
          "markdownDescription": "Canvas grid colour. Hex, `rgb()`/`rgba()`, `hsl()`/`hsla()` or a CSS colour name.",
          "scope": "window"
        },
        "tecture.graph.minimap.visible": {
