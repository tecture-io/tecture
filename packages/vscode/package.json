{
  "name": "tecture-vscode",
  "displayName": "Tecture",
  "description": "AI-generated architecture diagrams for complex codebases — rendered inside VS Code.",
  "version": "0.0.13",
  "type": "commonjs",
  "publisher": "Tecture",
  "license": "MIT",
  "pricing": "Free",
  "qna": "marketplace",
  "homepage": "https://github.com/tecture-io/tecture/tree/main/packages/vscode#readme",
  "bugs": {
    "url": "https://github.com/tecture-io/tecture/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tecture-io/tecture.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "architecture",
    "diagram",
    "c4",
    "tecture",
    "documentation"
  ],
  "galleryBanner": {
    "color": "#0a0f1a",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "icon": "media/icons/tecture-marketplace.png",
  "activationEvents": [
    "workspaceContains:architecture/manifest.json"
  ],
  "contributes": {
    "configuration": {
      "title": "Tecture",
      "properties": {
        "tecture.architecturePath": {
          "type": "string",
          "default": "architecture",
          "scope": "resource",
          "markdownDescription": "Path to the architecture folder (the one containing `manifest.json`), relative to the workspace folder root. Defaults to `architecture`."
        },
        "tecture.graph.edgeLabel.visible": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show labels on edges.",
          "scope": "window"
        },
        "tecture.graph.edgeLabel.backgroundColor": {
          "type": "string",
          "format": "color",
          "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:[rR][gG][bB]|[hH][sS][lL])[aA]?\\([ \\t\\n\\r\\f\\d.,%/+a-zA-Z-]*\\)|[a-zA-Z]{3,24})\\s*$",
          "patternErrorMessage": "Use hex (#rgb, #rrggbb, #rrggbbaa), rgb()/rgba(), hsl()/hsla() or a CSS colour name.",
          "maxLength": 64,
          "default": "#0a0f1a",
          "markdownDescription": "Edge label box fill. Hex, `rgb()`/`rgba()`, `hsl()`/`hsla()` or a CSS colour name.",
          "scope": "window"
        },
        "tecture.graph.edgeLabel.backgroundOpacity": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "markdownDescription": "Edge label box opacity (0 = transparent, 1 = opaque). Multiplies any alpha already in `backgroundColor`.",
          "scope": "window"
        },
        "tecture.graph.edgeLabel.textColor": {
          "type": "string",
          "format": "color",
          "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:[rR][gG][bB]|[hH][sS][lL])[aA]?\\([ \\t\\n\\r\\f\\d.,%/+a-zA-Z-]*\\)|[a-zA-Z]{3,24})\\s*$",
          "patternErrorMessage": "Use hex (#rgb, #rrggbb, #rrggbbaa), rgb()/rgba(), hsl()/hsla() or a CSS colour name.",
          "maxLength": 64,
          "default": "#e2e8f0",
          "markdownDescription": "Edge label text colour. Hex, `rgb()`/`rgba()`, `hsl()`/`hsla()` or a CSS colour name.",
          "scope": "window"
        },
        "tecture.graph.edgeLabel.fontSize": {
          "type": "number",
          "default": 10,
          "minimum": 6,
          "maximum": 32,
          "markdownDescription": "Edge label font size (px).",
          "scope": "window"
        },
        "tecture.graph.edgeLabel.fontWeight": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 900,
          "markdownDescription": "Edge label font weight (100–900).",
          "scope": "window"
        },
        "tecture.graph.edgeLabel.paddingX": {
          "type": "number",
          "default": 6,
          "minimum": 0,
          "maximum": 32,
          "markdownDescription": "Edge label horizontal padding (px).",
          "scope": "window"
        },
        "tecture.graph.edgeLabel.paddingY": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "maximum": 32,
          "markdownDescription": "Edge label vertical padding (px).",
          "scope": "window"
        },
        "tecture.graph.edgeLabel.borderRadius": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "maximum": 32,
          "markdownDescription": "Edge label corner radius (px).",
          "scope": "window"
        },
        "tecture.graph.edgeLabel.borderColor": {
          "type": [
            "string",
            "null"
          ],
          "format": "color",
          "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:[rR][gG][bB]|[hH][sS][lL])[aA]?\\([ \\t\\n\\r\\f\\d.,%/+a-zA-Z-]*\\)|[a-zA-Z]{3,24})\\s*$",
          "patternErrorMessage": "Use hex (#rgb, #rrggbb, #rrggbbaa), rgb()/rgba(), hsl()/hsla() or a CSS colour name.",
          "maxLength": 64,
          "default": null,
          "markdownDescription": "Edge label outline colour; `null` for no outline.",
          "scope": "window"
        },
        "tecture.graph.edgeLabel.wrap": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Wrap long edge labels onto multiple lines. Line length is set by `#tecture.graph.edgeLabel.wrapAt#`."
        },
        "tecture.graph.edgeLabel.wrapAt": {
          "type": "integer",
          "default": 18,
          "minimum": 4,
          "maximum": 200,
          "scope": "window",
          "markdownDescription": "Maximum characters per line when `#tecture.graph.edgeLabel.wrap#` is on, measured in Latin characters: CJK text and emoji are about twice as wide, so they wrap at roughly half this many. Breaks at word boundaries; a single longer word is split."
        },
        "tecture.graph.edge.strokeWidth": {
          "type": "number",
          "default": 1.5,
          "minimum": 0.5,
          "maximum": 8,
          "markdownDescription": "Edge line width (px).",
          "scope": "window"
        },
        "tecture.graph.edge.dashPattern": {
          "type": "string",
          "default": "5 5",
          "pattern": "^\\d+(?:\\.\\d+)?(?:(?:[ \\t\\n\\r\\f]*,[ \\t\\n\\r\\f]*|[ \\t\\n\\r\\f]+)\\d+(?:\\.\\d+)?)*$",
          "markdownDescription": "SVG dash pattern for edge types whose `dashed` is true (see `#tecture.graph.edgeTypes#`). A type's `dashed` decides *whether*; this decides *how*.",
          "scope": "window"
        },
        "tecture.graph.edge.arrowSize": {
          "type": "number",
          "default": 16,
          "minimum": 4,
          "maximum": 48,
          "markdownDescription": "Arrowhead size.",
          "scope": "window"
        },
        "tecture.graph.edge.cornerRadius": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 64,
          "markdownDescription": "Bend radius of stepped edges (px).",
          "scope": "window"
        },
        "tecture.graph.edge.animation": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "markdownDescription": "Edge flow animation. `auto` uses each edge type's `animated` flag; `always`/`never` override every type.",
          "enumDescriptions": [
            "Per edge type",
            "Animate all edges",
            "Animate no edges"
          ],
          "scope": "window"
        },
        "tecture.graph.node.minWidth": {
          "type": "number",
          "default": 160,
          "minimum": 60,
          "maximum": 220,
          "markdownDescription": "Minimum node width (px). Capped at 220, the width the automatic layout reserves for each node.",
          "scope": "window"
        },
        "tecture.graph.node.labelFontSize": {
          "type": "number",
          "default": 13,
          "minimum": 8,
          "maximum": 18,
          "markdownDescription": "Node label font size (px). Capped at 18 so labels fit the space the automatic layout reserves for each node.",
          "scope": "window"
        },
        "tecture.graph.node.technologyFontSize": {
          "type": "number",
          "default": 9,
          "minimum": 6,
          "maximum": 14,
          "markdownDescription": "Node technology tag font size (px). Capped at 14 so tags fit the space the automatic layout reserves for each node.",
          "scope": "window"
        },
        "tecture.graph.node.borderRadius": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "markdownDescription": "Node and container corner radius (px).",
          "scope": "window"
        },
        "tecture.graph.node.showIcons": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show node type icons.",
          "scope": "window"
        },
        "tecture.graph.node.showCornerMarks": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show blueprint corner marks on nodes. They are hidden on rounded nodes (`#tecture.graph.node.borderRadius#` above 0), where they would stick out past the corners.",
          "scope": "window"
        },
        "tecture.graph.container.backgroundOpacity": {
          "type": "number",
          "default": 0.03,
          "minimum": 0,
          "maximum": 1,
          "markdownDescription": "Opacity of the accent tint filling container nodes.",
          "scope": "window"
        },
        "tecture.graph.container.headerOpacity": {
          "type": "number",
          "default": 0.9,
          "minimum": 0,
          "maximum": 1,
          "markdownDescription": "Opacity of the container header bar.",
          "scope": "window"
        },
        "tecture.graph.container.borderStyle": {
          "type": "string",
          "enum": [
            "dashed",
            "solid",
            "dotted"
          ],
          "default": "dashed",
          "markdownDescription": "Container border style.",
          "scope": "window"
        },
        "tecture.graph.container.borderWidth": {
          "type": "number",
          "default": 1.5,
          "minimum": 0,
          "maximum": 8,
          "markdownDescription": "Container border width (px).",
          "scope": "window"
        },
        "tecture.graph.canvas.backgroundColor": {
          "type": "string",
          "format": "color",
          "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:[rR][gG][bB]|[hH][sS][lL])[aA]?\\([ \\t\\n\\r\\f\\d.,%/+a-zA-Z-]*\\)|[a-zA-Z]{3,24})\\s*$",
          "patternErrorMessage": "Use hex (#rgb, #rrggbb, #rrggbbaa), rgb()/rgba(), hsl()/hsla() or a CSS colour name.",
          "maxLength": 64,
          "default": "#141414",
          "markdownDescription": "Canvas background colour. Hex, `rgb()`/`rgba()`, `hsl()`/`hsla()` or a CSS colour name.",
          "scope": "window"
        },
        "tecture.graph.canvas.grid": {
          "type": "string",
          "enum": [
            "lines",
            "dots",
            "cross",
            "none"
