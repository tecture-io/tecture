                  "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:[rR][gG][bB]|[hH][sS][lL])[aA]?\\([ \\t\\n\\r\\f\\d.,%/+a-zA-Z-]*\\)|[a-zA-Z]{3,24})\\s*$",
                  "patternErrorMessage": "Use hex (#rgb, #rrggbb, #rrggbbaa), rgb()/rgba(), hsl()/hsla() or a CSS colour name.",
                  "maxLength": 64
                },
                "dashed": {
                  "type": "boolean"
                },
                "animated": {
                  "type": "boolean"
                }
              }
            },
            "default": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "color": {
                  "type": "string",
                  "format": "color",
                  "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:[rR][gG][bB]|[hH][sS][lL])[aA]?\\([ \\t\\n\\r\\f\\d.,%/+a-zA-Z-]*\\)|[a-zA-Z]{3,24})\\s*$",
                  "patternErrorMessage": "Use hex (#rgb, #rrggbb, #rrggbbaa), rgb()/rgba(), hsl()/hsla() or a CSS colour name.",
                  "maxLength": 64
                },
                "dashed": {
                  "type": "boolean"
                },
                "animated": {
                  "type": "boolean"
                }
              }
            }
          },
          "scope": "window"
        }
      }
    },
    "commands": [
      {
        "command": "tecture.open",
        "title": "Tecture: Open Architecture",
        "icon": "$(graph)"
      },
      {
        "command": "tecture.refresh",
        "title": "Tecture: Reload Architecture",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tecture",
          "title": "Tecture",
          "icon": "media/icons/tecture-activitybar.svg"
        }
      ]
    },
    "views": {
      "tecture": [
        {
          "id": "tectureDiagrams",
          "name": "Diagrams",
          "contextualTitle": "Tecture"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "tecture.refresh",
          "when": "view == tectureDiagrams",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tecture.open",
          "when": "view == tectureDiagrams && viewItem == diagram",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "build:webview": "vite build --config vite.webview.config.mts",
    "build:host": "tsup",
    "build": "pnpm build:webview && pnpm build:host",
    "typecheck": "tsc --noEmit",
    "compile:tests": "tsup --config tsup.test.config.ts",
    "test": "pnpm build && pnpm compile:tests && vscode-test",
    "vscode:package": "vsce package --no-dependencies",
    "vscode:ls": "vsce ls --no-dependencies",
    "publish:marketplace": "vsce publish --no-dependencies",
    "publish:openvsx": "ovsx publish --no-dependencies"
  },
  "dependencies": {
    "@tecture/shared": "workspace:*",
    "@tecture/web": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "ovsx": "^0.10.0",
    "@xyflow/react": "^12.10.2",
    "elkjs": "^0.11.1",
    "markdown-to-jsx": "^9.7.16",
    "mermaid": "^11.14.0",
    "mocha": "^10.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
